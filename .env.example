# Vite only exposes env vars prefixed with VITE_.
# Copy to `.env` or `.env.local` and fill in.

# Connect
VITE_INSTA=
VITE_FB=
VITE_EMAIL_FIRST=
VITE_EMAIL_LAST=
VITE_SPOTIFY_ARTIST_URL=
VITE_YOUTUBE_CHANNEL_URL=
VITE_BANDSINTOWN_ARTIST_URL=
VITE_TIKTOK_URL=
VITE_X_URL=

# Tour — optional. Register an app at Bandsintown for Artists to get app_id, then:
# VITE_BANDSINTOWN_APP_ID=yourAppId
# VITE_BANDSINTOWN_ARTIST_NAME=Artist Name
# If the API is not configured, add dates in src/data/tourDates.js (manualTourDates).

VITE_BANDSINTOWN_APP_ID=
VITE_BANDSINTOWN_ARTIST_NAME=
